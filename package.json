{
  "name": "assemble-agent",
  "version": "0.1.0",
  "description": "组装智能体：自由组装 MCP、Skills、知识库、系统提示词、模型，对外提供 OpenAI 兼容 /v1/chat/completions API",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test --test-force-exit \"tests/**/*.test.ts\"",
    "test:watch": "node --test --watch \"tests/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node src/index.ts",
    "seed": "node scripts/seed.ts",
    "templates": "node scripts/templates.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.83.0",
    "@earendil-works/pi-ai": "^0.83.0",
    "@hono/node-server": "^2.0.12",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^13.0.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.33",
    "iconv-lite": "^0.7.1",
    "jschardet": "^3.1.4",
    "mammoth": "^1.6.0",
    "papaparse": "^5.5.3",
    "pdf-parse": "^1.1.1",
    "pg": "^8.11.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/iconv-lite": "^0.0.1",
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.5.1",
    "@types/pdf-parse": "^1.1.3",
    "@types/pg": "^8.11.3",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3"
  }
}
